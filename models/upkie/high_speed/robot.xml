<mujoco model="upkie_high_speed_wide_four_bar">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" iterations="60"
          ls_iterations="20" noslip_iterations="4"/>

  <default>
    <joint armature="0.005" damping="0.15"/>
    <geom friction="0.8 0.01 0.001" solref="0.004 1"/>
    <default class="link">
      <geom type="capsule" size="0.012" contype="0" conaffinity="0"
            rgba="0.82 0.84 0.88 1"/>
    </default>
    <default class="wheel">
      <geom type="cylinder" size="0.120 0.032" friction="1.1 0.02 0.001"
            rgba="0.12 0.13 0.15 1"/>
    </default>
  </default>

  <worldbody>
    <body name="trunk" pos="0 0 0">
      <freejoint name="trunk_freejoint"/>
      <inertial pos="0.00014 0.00000 0.07200" mass="2.90"
                fullinertia="0.055 0.016 0.052 0 0 0"/>
      <geom name="trunk_collision" type="box" pos="0 0 0.086"
            size="0.095 0.328 0.048" rgba="0.34 0.28 0.60 1"/>
      <geom name="trunk_pod" type="box" pos="0 0 0.148"
            size="0.072 0.126 0.048" rgba="0.40 0.32 0.68 1"
            contype="0" conaffinity="0"/>
      <geom name="left_sponson" type="box" pos="0 0.278 0.076"
            size="0.070 0.054 0.030" rgba="0.30 0.24 0.52 1"
            contype="0" conaffinity="0"/>
      <geom name="right_sponson" type="box" pos="0 -0.278 0.076"
            size="0.070 0.054 0.030" rgba="0.30 0.24 0.52 1"
            contype="0" conaffinity="0"/>
      <geom name="axle_beam" type="capsule" fromto="0 0.336 0.050 0 -0.336 0.050"
            size="0.016" rgba="0.22 0.20 0.38 1"
            contype="0" conaffinity="0"/>
      <site name="imu" pos="-0.04095 0.04000 0.155" size="0.006"/>

      <!-- Left x-z compliant carrier. -->
      <body name="left_hip_carrier" pos="0 0.3411 0.0602">
        <joint name="left_hip_slide_x" type="slide" axis="1 0 0"
               range="-0.020 0.020" stiffness="3000" damping="100"
               springref="0" armature="0.02"/>
        <joint name="left_hip_slide_z" type="slide" axis="0 0 1"
               range="-0.025 0.025" stiffness="7000" damping="180"
               springref="0" armature="0.02"/>
        <inertial pos="0 0 0" mass="0.08" diaginertia="0.00008 0.00008 0.00008"/>
        <geom type="box" size="0.027 0.014 0.027" density="0"
              contype="0" conaffinity="0" rgba="0.10 0.65 0.95 1"/>
        <site name="left_hip_origin" size="0.008" rgba="0.10 0.65 0.95 1"/>

        <body name="left_front_upper" pos="0 0 0">
          <joint name="left_hip" type="hinge" axis="0 1 0" range="-0.65 0.65"/>
          <geom class="link" fromto="0 0 0 0.075 0 -0.174" mass="0.24"
                rgba="0.95 0.55 0.12 1"/>
          <site name="left_front_knee" pos="0.075 0 -0.174" size="0.009"
                rgba="0.95 0.55 0.12 1"/>

          <body name="left_front_lower" pos="0.075 0 -0.174">
            <joint name="left_front_knee_hinge" type="hinge" axis="0 1 0"/>
            <geom class="link" fromto="0 0 0 -0.075 0 -0.174" mass="0.21"
                  rgba="0.95 0.55 0.12 1"/>

            <!-- Telescopic crossbar points from front knee toward rear knee. -->
            <body name="left_strut_outer" quat="0 0 0 1">
              <joint name="left_strut_angle" type="hinge" axis="0 1 0"/>
              <geom name="left_strut_sleeve" type="capsule"
                    fromto="0 0 0 0.140 0 0" size="0.011"
                    mass="0.15" contype="0" conaffinity="0"
                    rgba="0.15 0.78 0.42 1"/>
              <site name="left_strut_sleeve_end" pos="0.140 0 0" size="0.004"/>
              <body name="left_strut_middle" pos="0.050 0 0">
                <joint name="left_strut_extension" type="slide" axis="1 0 0"
                       range="-0.020 0.094" stiffness="1600" damping="100"
                       springref="0" armature="0.03"/>
                <geom name="left_strut_middle_sleeve" type="capsule"
                      fromto="-0.040 0 0 0.100 0 0" size="0.008"
                      mass="0.07" contype="0" conaffinity="0"
                      rgba="0.85 0.95 0.88 1"/>
                <site name="left_strut_middle_rear" pos="-0.040 0 0" size="0.004"/>
                <site name="left_strut_middle_end" pos="0.100 0 0" size="0.004"/>
                <body name="left_strut_inner" pos="0.050 0 0">
                  <joint name="left_strut_extension_stage2" type="slide" axis="1 0 0"
                         range="-0.020 0.094" stiffness="1600" damping="100"
                         springref="0" armature="0.03"/>
                  <geom name="left_strut_rod" type="capsule"
                        fromto="-0.070 0 0 0.050 0 0" size="0.0055"
                        mass="0.03" contype="0" conaffinity="0"
                        rgba="0.98 0.72 0.20 1"/>
                  <site name="left_strut_rod_rear" pos="-0.070 0 0" size="0.004"/>
                  <site name="left_strut_endpoint" pos="0.050 0 0" size="0.008"
                        rgba="0.15 0.78 0.42 1"/>
                </body>
              </body>
            </body>

            <body name="left_wheel_node" pos="-0.075 0 -0.174">
              <joint name="left_front_bottom_hinge" type="hinge" axis="0 1 0"/>
              <inertial pos="0 0 0" mass="0.02" diaginertia="0.00002 0.00002 0.00002"/>
              <site name="left_bottom_closure" size="0.008"/>
              <body name="left_wheel">
                <joint name="left_wheel_joint" type="hinge" axis="0 1 0"
                       damping="0.005"/>
                <geom class="wheel" quat="0.7071068 0.7071068 0 0" mass="0.2385"/>
              </body>
            </body>
          </body>
        </body>

        <body name="left_rear_upper" pos="0 0 0">
          <joint name="left_rear_hip_hinge" type="hinge" axis="0 1 0"/>
          <geom class="link" fromto="0 0 0 -0.075 0 -0.174" mass="0.24"
                rgba="0.20 0.52 0.92 1"/>
          <site name="left_rear_knee" pos="-0.075 0 -0.174" size="0.009"
                rgba="0.20 0.52 0.92 1"/>
          <body name="left_rear_lower" pos="-0.075 0 -0.174">
            <joint name="left_rear_knee_hinge" type="hinge" axis="0 1 0"/>
            <geom class="link" fromto="0 0 0 0.075 0 -0.174" mass="0.21"
                  rgba="0.20 0.52 0.92 1"/>
            <site name="left_rear_bottom_endpoint" pos="0.075 0 -0.174" size="0.008"/>
          </body>
        </body>
      </body>

      <!-- Right x-z compliant carrier. -->
      <body name="right_hip_carrier" pos="0 -0.3411 0.0602">
        <joint name="right_hip_slide_x" type="slide" axis="1 0 0"
               range="-0.020 0.020" stiffness="3000" damping="100"
               springref="0" armature="0.02"/>
        <joint name="right_hip_slide_z" type="slide" axis="0 0 1"
               range="-0.025 0.025" stiffness="7000" damping="180"
               springref="0" armature="0.02"/>
        <inertial pos="0 0 0" mass="0.08" diaginertia="0.00008 0.00008 0.00008"/>
        <geom type="box" size="0.027 0.014 0.027" density="0"
              contype="0" conaffinity="0" rgba="0.10 0.65 0.95 1"/>
        <site name="right_hip_origin" size="0.008" rgba="0.10 0.65 0.95 1"/>

        <body name="right_front_upper" pos="0 0 0">
          <joint name="right_hip" type="hinge" axis="0 1 0" range="-0.65 0.65"/>
          <geom class="link" fromto="0 0 0 0.075 0 -0.174" mass="0.24"
                rgba="0.95 0.55 0.12 1"/>
          <site name="right_front_knee" pos="0.075 0 -0.174" size="0.009"
                rgba="0.95 0.55 0.12 1"/>

          <body name="right_front_lower" pos="0.075 0 -0.174">
            <joint name="right_front_knee_hinge" type="hinge" axis="0 1 0"/>
            <geom class="link" fromto="0 0 0 -0.075 0 -0.174" mass="0.21"
                  rgba="0.95 0.55 0.12 1"/>

            <body name="right_strut_outer" quat="0 0 0 1">
              <joint name="right_strut_angle" type="hinge" axis="0 1 0"/>
              <geom name="right_strut_sleeve" type="capsule"
                    fromto="0 0 0 0.140 0 0" size="0.011"
                    mass="0.15" contype="0" conaffinity="0"
                    rgba="0.15 0.78 0.42 1"/>
              <site name="right_strut_sleeve_end" pos="0.140 0 0" size="0.004"/>
              <body name="right_strut_middle" pos="0.050 0 0">
                <joint name="right_strut_extension" type="slide" axis="1 0 0"
                       range="-0.020 0.094" stiffness="1600" damping="100"
                       springref="0" armature="0.03"/>
                <geom name="right_strut_middle_sleeve" type="capsule"
                      fromto="-0.040 0 0 0.100 0 0" size="0.008"
                      mass="0.07" contype="0" conaffinity="0"
                      rgba="0.85 0.95 0.88 1"/>
                <site name="right_strut_middle_rear" pos="-0.040 0 0" size="0.004"/>
                <site name="right_strut_middle_end" pos="0.100 0 0" size="0.004"/>
                <body name="right_strut_inner" pos="0.050 0 0">
                  <joint name="right_strut_extension_stage2" type="slide" axis="1 0 0"
                         range="-0.020 0.094" stiffness="1600" damping="100"
                         springref="0" armature="0.03"/>
                  <geom name="right_strut_rod" type="capsule"
                        fromto="-0.070 0 0 0.050 0 0" size="0.0055"
                        mass="0.03" contype="0" conaffinity="0"
                        rgba="0.98 0.72 0.20 1"/>
                  <site name="right_strut_rod_rear" pos="-0.070 0 0" size="0.004"/>
                  <site name="right_strut_endpoint" pos="0.050 0 0" size="0.008"
                        rgba="0.15 0.78 0.42 1"/>
                </body>
              </body>
            </body>

            <body name="right_wheel_node" pos="-0.075 0 -0.174">
              <joint name="right_front_bottom_hinge" type="hinge" axis="0 1 0"/>
              <inertial pos="0 0 0" mass="0.02" diaginertia="0.00002 0.00002 0.00002"/>
              <site name="right_bottom_closure" size="0.008"/>
              <body name="right_wheel">
                <joint name="right_wheel_joint" type="hinge" axis="0 1 0"
                       damping="0.005"/>
                <geom class="wheel" quat="0.7071068 0.7071068 0 0" mass="0.2385"/>
              </body>
            </body>
          </body>
        </body>

        <body name="right_rear_upper" pos="0 0 0">
          <joint name="right_rear_hip_hinge" type="hinge" axis="0 1 0"/>
          <geom class="link" fromto="0 0 0 -0.075 0 -0.174" mass="0.24"
                rgba="0.20 0.52 0.92 1"/>
          <site name="right_rear_knee" pos="-0.075 0 -0.174" size="0.009"
                rgba="0.20 0.52 0.92 1"/>
          <body name="right_rear_lower" pos="-0.075 0 -0.174">
            <joint name="right_rear_knee_hinge" type="hinge" axis="0 1 0"/>
            <geom class="link" fromto="0 0 0 0.075 0 -0.174" mass="0.21"
                  rgba="0.20 0.52 0.92 1"/>
            <site name="right_rear_bottom_endpoint" pos="0.075 0 -0.174" size="0.008"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="left_four_bar_closure"
             site1="left_rear_bottom_endpoint" site2="left_bottom_closure"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
    <connect name="left_strut_closure"
             site1="left_strut_endpoint" site2="left_rear_knee"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
    <joint name="left_strut_stage_sync"
           joint1="left_strut_extension" joint2="left_strut_extension_stage2"
           polycoef="0 1 0 0 0" solref="0.0002 1"
           solimp="0.999 0.9999 0.0001"/>
    <connect name="right_four_bar_closure"
             site1="right_rear_bottom_endpoint" site2="right_bottom_closure"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
    <connect name="right_strut_closure"
             site1="right_strut_endpoint" site2="right_rear_knee"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
    <joint name="right_strut_stage_sync"
           joint1="right_strut_extension" joint2="right_strut_extension_stage2"
           polycoef="0 1 0 0 0" solref="0.0002 1"
           solimp="0.999 0.9999 0.0001"/>
  </equality>

  <actuator>
    <position name="left_hip" joint="left_hip" kp="30" kv="1.5"
              ctrlrange="-0.65 0.65" forcerange="-16 16"/>
    <position name="left_strut" joint="left_strut_extension" kp="8000" kv="100"
              ctrlrange="-0.040 0.165" forcerange="-700 700"/>
    <motor name="left_wheel" joint="left_wheel_joint"
           ctrlrange="-6 6" forcerange="-6 6"/>
    <position name="right_hip" joint="right_hip" kp="30" kv="1.5"
              ctrlrange="-0.65 0.65" forcerange="-16 16"/>
    <position name="right_strut" joint="right_strut_extension" kp="8000" kv="100"
              ctrlrange="-0.040 0.165" forcerange="-700 700"/>
    <motor name="right_wheel" joint="right_wheel_joint"
           ctrlrange="-6 6" forcerange="-6 6"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <velocimeter name="imu_velocity" site="imu"/>
    <jointpos name="left_strut_pos" joint="left_strut_extension"/>
    <jointvel name="left_strut_vel" joint="left_strut_extension"/>
    <jointpos name="right_strut_pos" joint="right_strut_extension"/>
    <jointvel name="right_strut_vel" joint="right_strut_extension"/>
    <jointpos name="left_hip_slide_x_pos" joint="left_hip_slide_x"/>
    <jointpos name="left_hip_slide_z_pos" joint="left_hip_slide_z"/>
    <jointpos name="right_hip_slide_x_pos" joint="right_hip_slide_x"/>
    <jointpos name="right_hip_slide_z_pos" joint="right_hip_slide_z"/>
  </sensor>
</mujoco>
