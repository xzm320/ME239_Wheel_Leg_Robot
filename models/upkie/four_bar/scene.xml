<!-- Active four-bar Upkie test scene. -->
<mujoco model="upkie_active_four_bar_scene">
  <include file="robot.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.12 0.18 0.25 1"/>
    <global offwidth="960" offheight="720" azimuth="135" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.50 0.68"
             rgb2="0.03 0.04 0.06" width="512" height="3072"/>
    <texture type="2d" name="ground_grid" builtin="checker" mark="edge"
             rgb1="0.20 0.24 0.28" rgb2="0.10 0.12 0.14"
             markrgb="0.75 0.80 0.85" width="512" height="512"/>
    <material name="ground" texture="ground_grid" texuniform="true"
              texrepeat="8 8" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light pos="1 -1 3" dir="-0.2 0.2 -1" directional="true"/>
    <geom name="floor" type="plane" size="4 4 0.05" material="ground"/>
  </worldbody>
</mujoco>
